<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.StackPane?>

<StackPane
        prefHeight="870.0"
        prefWidth="500.0"
        xmlns="http://javafx.com/javafx/25"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="com.library.controllers.SplashController">
    <children>
        <ImageView
                fitHeight="500.0"
                fitWidth="870.0"
                pickOnBounds="true"
                preserveRatio="false">
            <image>
                <Image url="@img/Fondos/FSN.png" />
            </image>
        </ImageView>

        <AnchorPane
                prefHeight="686.0"
                prefWidth="870.0">

            <Button
                    fx:id="btnInfo"
                    layoutX="110.0"
                    layoutY="275.0"
                    prefHeight="50.0"
                    prefWidth="120.0"
                    style="-fx-background-color: transparent;">

                <graphic>
                    <ImageView
                            fitHeight="100.0"
                            fitWidth="120.0">
                        <image>
                            <Image url="@img/Botones/BE.png" />
                        </image>
                    </ImageView>
                </graphic>
            </Button>

            <Button fx:id="btnIniciarSesion"
                    AnchorPane.rightAnchor="30.0"
                    AnchorPane.topAnchor="20.0"
                    prefHeight="90.0"
                    prefWidth="180.0"
                    style="-fx-background-color: transparent;">
                <graphic>
                    <ImageView fx:id="imgIniciarSesion"
                               fitHeight="90.0"
                               fitWidth="180.0"
                               preserveRatio="true"
                               smooth="true">
                        <image>
                            <Image url="@img/Botones/BPIS.png" />
                        </image>
                    </ImageView>
                </graphic>
            </Button>

        </AnchorPane>
    </children>


</StackPane>
