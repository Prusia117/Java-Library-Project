<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.StackPane?>

<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.text.Font?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<StackPane
        prefHeight="870.0"
        prefWidth="500.0"
        xmlns="http://javafx.com/javafx/25"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="com.library.controllers.BooksDetailsController">

    <children>
        <ImageView
                fitHeight="500.0"
                fitWidth="870.0"
                pickOnBounds="true"
                preserveRatio="false">
            <image>
                <Image url="@img/Fondos/FSL.png"/>
            </image>
        </ImageView>


        <ImageView
                fx:id="imgPortadaDetalle"
                fitHeight="200.0"
                fitWidth="200.0"
                translateX="-300.0"
                translateY="-90.0"
                pickOnBounds="true"
                preserveRatio="false">
        </ImageView>

        <Label
                fx:id="lblDescripcionDetalle"
                wrapText="true"
                textFill="BLACK"
                maxWidth="300.0"
                StackPane.alignment="TOP_LEFT">
            <font>
                <Font size="14.0"/>
            </font>
            <StackPane.margin>
                <Insets top="100.0" left="250.0"/>
            </StackPane.margin>
        </Label>

        <Button text="Leer"
                fx:id="btnLeerBlaze"
                onAction="#abrirLibroBlaze" prefWidth="120.0"
                prefHeight="40.0"
                StackPane.alignment="TOP_LEFT">

            <style>
                -fx-background-color: #FF5722; /* Color Naranja */
                -fx-text-fill: white; /* Texto Blanco */
                -fx-font-weight: bold; /* Texto en Negrita */
                -fx-background-radius: 20; /* Bordes Redondeados */
                -fx-cursor: hand; /* Manita al pasar el mouse */
                -fx-font-size: 14px;
            </style>

            <StackPane.margin>
                <Insets top="280.0" left="70.0"/>
            </StackPane.margin>
        </Button>
    </children>
</StackPane>

