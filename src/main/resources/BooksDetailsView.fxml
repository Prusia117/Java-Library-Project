<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.effect.DropShadow?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.library.controllers.BooksDetailsController"
            prefWidth="900" prefHeight="700"
            style="-fx-background-color: #f5f5f5;">

    <!-- Header -->
    <top>
        <VBox style="-fx-background-color: #2c3e50; -fx-padding: 20;">
            <!-- Botón Regresar -->
            <Button text="← Regresar a Lista" onAction="#regresarALista" 
                    style="-fx-background-color: #34495e; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-background-radius: 5; -fx-cursor: hand; -fx-padding: 8 15 8 15;">
                <VBox.margin>
                    <Insets bottom="10"/>
                </VBox.margin>
            </Button>
            
            <Label text="Detalles del Libro" 
                   style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: white;"/>
        </VBox>
    </top>

    <!-- Contenido -->
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;">
            <VBox spacing="20" style="-fx-padding: 30;">
                
                <!-- Contenedor principal -->
                <HBox spacing="30" style="-fx-background-color: white; -fx-padding: 30; -fx-background-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 3);">
                    
                    <!-- Imagen con sombra -->
                    <VBox alignment="CENTER">
                        <StackPane>
                            <ImageView fx:id="imagenLibro" fitWidth="250" fitHeight="350" preserveRatio="true"
                                      style="-fx-effect: dropshadow(gaussian, rgba(0,0,0,0.25), 10, 0, 0, 5);"/>
                        </StackPane>
                    </VBox>
                    
                    <!-- Información -->
                    <VBox spacing="15" HBox.hgrow="ALWAYS">
                        <Label fx:id="lblTitulo" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" wrapText="true"/>
                        
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Label text="Autor:" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #34495e;"/>
                            <Label fx:id="lblAutor" style="-fx-font-size: 16px; -fx-text-fill: #7f8c8d;"/>
                        </HBox>
                        
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Label text="Año:" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #34495e;"/>
                            <Label fx:id="lblAnio" style="-fx-font-size: 16px; -fx-text-fill: #7f8c8d;"/>
                        </HBox>
                        
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Label text="Categoría:" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #34495e;"/>
                            <Label fx:id="lblCategoria" style="-fx-font-size: 16px; -fx-text-fill: #7f8c8d;"/>
                        </HBox>
                        
                        <!-- Separador -->
                        <Separator>
                            <VBox.margin>
                                <Insets top="10" bottom="10"/>
                            </VBox.margin>
                        </Separator>
                        
                        <!-- Botones de acción -->
                        <VBox spacing="15">
                            <Label text="Acciones:" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #34495e;"/>
                            
                            <HBox spacing="15">
                                <Button fx:id="btnLeerPDF" text="Leer PDF" onAction="#abrirPDF"
                                        prefWidth="180" prefHeight="45"
                                        style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;"/>
                                
                                <Button text="Descargar" onAction="#descargarPDF"
                                        prefWidth="180" prefHeight="45"
                                        style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;"/>
                            </HBox>
                        </VBox>
                    </VBox>
                </HBox>
                
            </VBox>
        </ScrollPane>
    </center>

</BorderPane>