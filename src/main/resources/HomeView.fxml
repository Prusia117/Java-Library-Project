<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<StackPane xmlns="http://javafx.com/javafx/25"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.library.controllers.HomeController"
           prefWidth="870" prefHeight="500">

    <children>
        <!-- Imagen de fondo -->
        <ImageView fitWidth="870" fitHeight="500" preserveRatio="false">
            <image>
                <Image url="@img/Fondos/FE.png"/>
            </image>
        </ImageView>

        <!-- Contenido principal -->
        <VBox spacing="30" alignment="CENTER" style="-fx-padding: 40;">
            
            <!-- Título -->
            <Label text="Biblioteca Digital" 
                   style="-fx-font-size: 42px; -fx-font-weight: bold; -fx-text-fill: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.8), 10, 0, 0, 3);"/>
            
            <!-- Botones principales más pequeños -->
            <HBox spacing="25" alignment="CENTER">
                
                <!-- Botón Ver Libros -->
                <VBox spacing="8" alignment="CENTER" 
                      style="-fx-background-color: rgba(255, 255, 255, 0.95); -fx-padding: 20; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 12, 0, 0, 4);">
                    <Button text="Ver Libros" onAction="#irALibros" 
                            prefWidth="160" prefHeight="45"
                            style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;"/>
                    <Label text="Explorar catálogo" style="-fx-font-size: 11px; -fx-text-fill: #7f8c8d;"/>
                </VBox>
                
                <!-- Botón CRUD Libros -->
                <VBox spacing="8" alignment="CENTER" 
                      style="-fx-background-color: rgba(255, 255, 255, 0.95); -fx-padding: 20; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 12, 0, 0, 4);">
                    <Button text="Gestión de Libros" onAction="#irACRUDLibros" 
                            prefWidth="160" prefHeight="45"
                            style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;"/>
                    <Label text="Gestionar libros" style="-fx-font-size: 11px; -fx-text-fill: #7f8c8d;"/>
                </VBox>
                
                <!-- Botón CRUD Usuarios -->
                <VBox spacing="8" alignment="CENTER" 
                      style="-fx-background-color: rgba(255, 255, 255, 0.95); -fx-padding: 20; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 12, 0, 0, 4);">
                    <Button text="Gestión de Usuarios" onAction="#irACRUDUsuarios" 
                            prefWidth="160" prefHeight="45"
                            style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;"/>
                    <Label text="Gestionar usuarios" style="-fx-font-size: 11px; -fx-text-fill: #7f8c8d;"/>
                </VBox>
                
            </HBox>
            
            <!-- Botón Salir -->
            <Button text="Salir" onAction="#salir" 
                    prefWidth="120" prefHeight="35"
                    style="-fx-background-color: rgba(189, 195, 199, 0.9); -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;"/>
        </VBox>

    </children>
</StackPane>