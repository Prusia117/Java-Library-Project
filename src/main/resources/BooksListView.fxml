<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="870.0" prefWidth="800.0"
      style="-fx-background-color: linear-gradient(to bottom right, #ffffff, #ece9e6);"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.library.controllers.BooksListController">

    <children>
        <!-- Header -->
        <VBox alignment="CENTER_LEFT" spacing="5.0"
              style="-fx-background-color: #2c3e50; -fx-padding: 25; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.3), 10, 0, 0, 5);">
            <children>
                <!-- Botón Regresar -->
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Button text="← Regresar" onAction="#regresarAHome" 
                            style="-fx-background-color: #34495e; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-background-radius: 5; -fx-cursor: hand; -fx-padding: 8 15 8 15;"/>
                </HBox>
                
                <Label text="Biblioteca NTR" textFill="WHITE">
                    <font>
                        <Font name="System Bold" size="28.0" />
                    </font>
                    <VBox.margin>
                        <Insets top="10"/>
                    </VBox.margin>
                </Label>
                <Label text="Explora nuestra colección de libros disponibles" textFill="#bdc3c7">
                    <font>
                        <Font size="14.0" />
                    </font>
                </Label>
            </children>
        </VBox>

        <ScrollPane fitToHeight="true" fitToWidth="true"
                    style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;"
                    VBox.vgrow="ALWAYS">
            <content>
                <FlowPane fx:id="contenedorLibros" hgap="25.0" style="-fx-background-color: transparent;" vgap="25.0">
                    <padding>
                        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
                    </padding>
                </FlowPane>
            </content>
        </ScrollPane>
    </children>
</VBox>