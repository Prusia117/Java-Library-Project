<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.library.controllers.UsersCRUDFormController">

    <!-- TÍTULO -->
    <top>
        <Label text="Gestión de Usuarios"
               style="-fx-font-size: 22px; -fx-padding: 10;"
               BorderPane.alignment="CENTER"/>
    </top>

    <!-- CONTENIDO -->
    <center>
        <VBox spacing="15" >

            <!-- TABLA -->
            <TableView fx:id="tablaUsuarios" prefHeight="250">
                <columns>
                    <TableColumn fx:id="colId" text="ID" prefWidth="60"/>
                    <TableColumn fx:id="colNombre" text="Nombre" prefWidth="150"/>
                    <TableColumn fx:id="colCorreo" text="Correo" prefWidth="200"/>
                    <TableColumn fx:id="colPassword" text="Contraseña" prefWidth="150"/>
                </columns>
            </TableView>

            <!-- FORMULARIO -->
            <GridPane hgap="10" vgap="10">
                <columnConstraints>
                    <ColumnConstraints prefWidth="100" halignment="RIGHT"/>
                    <ColumnConstraints prefWidth="200"/>
                </columnConstraints>

                <Label text="Nombre:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <TextField fx:id="txtNombre" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                <Label text="Correo:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <TextField fx:id="txtCorreo" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                <Label text="Contraseña:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <PasswordField fx:id="txtPassword" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
            </GridPane>

            <!-- BOTONES -->
            <HBox spacing="10" alignment="CENTER">
                <Button text="Agregar" onAction="#onAgregar"/>
                <Button text="Actualizar" onAction="#onActualizar"/>
                <Button text="Eliminar" onAction="#onEliminar"/>
                <Button text="Limpiar" onAction="#limpiar"/>
            </HBox>

        </VBox>
    </center>

</BorderPane>